<dl class="spec">
  {%- if stack %}
  <dt>stack</dt>
  <dd class="spec__tags">{{ stack | join(" · ") }}</dd>
  {%- endif %}
  <dt>date</dt>
  <dd class="spec__date">{{ listingLabel }}</dd>
  {%- if repo %}
  <dt>repo</dt>
  <dd><a href="{{ repo }}" target="_blank" rel="noreferrer">{{ repo | replace("https://", "") }}</a></dd>
  {%- endif %}
</dl>
