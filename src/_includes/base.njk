<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles/main.css?v=20261029a" />
    {% if isCacheArticle %}{% include "cache-article-meta.njk" %}{% elif articleMeta %}{% set meta = articleMeta %}{% include "article-meta.njk" %}{% endif %}
    {%- for w in widgets %}
    <link rel="stylesheet" href="{{ w }}.css?v={{ widgetVersion }}" />
    {%- endfor %}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="brand-group">
          <a class="brand" href="/">Jacen Li</a>
        </div>
        <nav class="site-nav">
          {%- set links = [["Home", "/", "home"], ["Projects", "/projects/", "projects"], ["Machines", "/machines/", "machines"], ["Writings", "/writings/", "writings"], ["About", "/about/", "about"]] %}
          {%- for name, href, key in links %}
          <a{% if nav == key %} class="active" aria-current="page"{% endif %} href="{{ href }}">{{ name }}</a>
          {%- endfor %}
        </nav>
      </div>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>© <span id="current-year"></span> Jacen Li. All rights reserved.</span>
        <div class="site-footer__links">
          <a href="https://github.com/jtl06" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/jacen-li/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="mailto:jacenli@icloud.com">jacenli@icloud.com</a>
          <a href="/tree/">site index</a>
        </div>
      </div>
    </footer>
    <script>
      const yearTarget = document.getElementById("current-year");
      if (yearTarget) {
        yearTarget.textContent = new Date().getFullYear();
      }
    </script>
    {%- for w in widgets %}
    <script src="{{ w }}.js?v={{ widgetVersion }}"></script>
    {%- endfor %}
  </body>
</html>
