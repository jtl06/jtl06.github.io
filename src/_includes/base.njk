<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles/main.css?v=20261012b" />
    {% if isCacheArticle %}{% include "cache-article-meta.njk" %}{% endif %}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">[jacenli]</a>
        <nav class="site-nav" aria-label="Site">
          {%- set windows = [["home", "/", "home"], ["projects", "/projects/", "projects"], ["keyboards", "/keyboards/", "keyboards"], ["writings", "/writings/", "writings"], ["about", "/about/", "about"]] %}
          {%- for name, href, key in windows %}
          <a{% if nav == key %} class="active" aria-current="page"{% endif %} href="{{ href }}"><span class="site-nav__index" aria-hidden="true">{{ loop.index0 }}:</span>{{ name }}</a>
          {%- endfor %}
          <button class="console-toggle" type="button" aria-label="Open terminal" title="Terminal (`)" hidden>&gt;_</button>
        </nav>
      </div>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>© <span id="current-year"></span> Jacen Li. All rights reserved.</span>
        <div class="site-footer__links">
          <a href="https://github.com/jtl06" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/jacen-li/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="mailto:jacenli@icloud.com">jacenli@icloud.com</a>
          <a href="/tree/">site index</a>
        </div>
      </div>
    </footer>
    <script>
      const yearTarget = document.getElementById("current-year");
      if (yearTarget) {
        yearTarget.textContent = new Date().getFullYear();
      }

      // Terminal: docked on wide screens, so it loads right away there;
      // on narrow screens it loads when opened, or when it was open on the previous page.
      (() => {
        const toggle = document.querySelector(".console-toggle");
        let loading = null;
        const load = () =>
          (loading ||= new Promise((resolve, reject) => {
            const script = document.createElement("script");
            script.src = "/js/console.js?v=20261011a";
            script.onload = resolve;
            script.onerror = reject;
            document.head.append(script);
          }));
        const openConsole = () => load().then(() => window.siteConsole.toggle());

        toggle.hidden = false;
        toggle.addEventListener("click", openConsole);
        document.addEventListener("keydown", (event) => {
          if (event.key !== "`" || event.ctrlKey || event.metaKey || event.altKey) return;
          if (event.target.closest("input, textarea, [contenteditable]")) return;
          event.preventDefault();
          openConsole();
        });

        let reopen = false;
        try {
          reopen = JSON.parse(sessionStorage.getItem("console:state"))?.open;
        } catch {}
        if (window.matchMedia("(min-width: 768px)").matches || reopen) load();
      })();
    </script>
  </body>
</html>
