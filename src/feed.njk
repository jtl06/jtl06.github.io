---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
{%- set posts = collections.writings | sortByDateDescending -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Jacen Li</title>
  <subtitle>Writings on low-level hardware and software systems.</subtitle>
  <link href="https://jacen.li/feed.xml" rel="self" />
  <link href="https://jacen.li/writings/" />
  <id>https://jacen.li/</id>
  <updated>{{ posts[0].date.toISOString() }}</updated>
  <author><name>Jacen Li</name></author>
  {%- for post in posts %}
  <entry>
    <title>{{ post.data.listingTitle }}</title>
    <link href="https://jacen.li{{ post.url }}" />
    <id>https://jacen.li{{ post.url }}</id>
    <published>{{ post.date.toISOString() }}</published>
    <updated>{{ post.date.toISOString() }}</updated>
    <summary>{{ post.data.summary }}</summary>
  </entry>
  {%- endfor %}
</feed>
